---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---
<figure class="figure">
  <Image src={src} alt={alt} widths={[640, 1024, 1440]} sizes="(min-width: 52rem) 42rem, 100vw" loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
