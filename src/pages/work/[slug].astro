---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Painted from "../../components/Painted.astro";
import Edit from "../../components/Edit.astro";
import Todo from "../../components/Todo.astro";

export async function getStaticPaths() {
  const flagships = (await getCollection("work")).filter((w) => w.data.flagship).sort((a, b) => a.data.order - b.data.order);
  return flagships.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: flagships[(i + 1) % flagships.length] } }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.description} image={`/og/${entry.id}.png`}>
  <article class="case">
    <header class="case__head frame grid">
      <p class="case__back meta"><a href="/#work">All work</a></p>
      <Painted as="h1" top class="case__title">{d.title}</Painted>
      <p class="case__summary">{d.summary}</p>
    </header>

    {d.cover && (
      <figure class="case__cover frame">
        <Image src={d.cover} alt={d.coverAlt ?? ""} widths={[640, 1024, 1600]} sizes="(min-width: 90rem) 90rem, 100vw" loading="eager" fetchpriority="high" />
      </figure>
    )}

    <div class="case__body frame grid">
      <aside class="case__facts" aria-label="Project facts">
        <dl>
          <div><dt>Role</dt><dd>{d.role}</dd></div>
          {d.when && <div><dt>When</dt><dd>{d.when}</dd></div>}
          {d.team && <div><dt>With</dt><dd>{d.team}</dd></div>}
          <div><dt>Built with</dt><dd>{d.stack.join(", ")}</dd></div>
        </dl>
        {d.links.length > 0 && (
          <ul class="case__links">{d.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        )}
      </aside>
      <div class="prose case__prose">
        <Content components={{ Edit, Todo }} />
      </div>
    </div>

    <nav class="case__next frame" aria-label="Next case study">
      <p class="meta">Next case study</p>
      <Painted as="p" href={`/work/${next.id}/`}>{next.data.title}</Painted>
    </nav>
  </article>
</Base>

<style>
  .case__head {
    padding-top: var(--s-8);
    row-gap: var(--s-5);
  }
  .case__back,
  .case__title {
    grid-column: 1 / -1;
  }
  .case__summary {
    grid-column: 1 / span 8;
    font-size: var(--step-2);
    font-family: var(--display);
    line-height: 1.2;
    letter-spacing: var(--track-heading);
    max-width: 34ch;
  }
  .case__cover {
    margin-top: var(--s-8);
    margin-bottom: 0;
    position: relative;
    z-index: 1;
  }
  .case__cover img {
    width: 100%;
    max-height: 80vh;
    object-fit: cover;
    object-position: top left;
    outline: 1px solid var(--rule);
  }
  .case__body {
    margin-top: var(--s-8);
    align-items: start;
  }
  .case__facts {
    grid-column: 1 / span 3;
    position: sticky;
    top: var(--s-6);
    font-family: var(--display);
    font-size: var(--step--1);
  }
  .case__facts dl {
    margin: 0;
    display: grid;
    gap: var(--s-4);
  }
  .case__facts dt {
    color: var(--shade);
  }
  .case__facts dd {
    margin: 0;
    font-weight: 500;
  }
  .case__links {
    list-style: none;
    padding: 0;
    margin: var(--s-5) 0 0;
    display: grid;
    gap: var(--s-2);
    font-weight: 600;
  }
  .case__prose {
    grid-column: 4 / span 7;
  }
  .case__prose :global(h2:first-child) {
    margin-top: 0;
  }
  .case__next {
    margin-top: var(--s-11);
  }
  .case__next .meta {
    margin-bottom: var(--s-3);
  }

  @media (max-width: 52rem) {
    .case__summary,
    .case__facts,
    .case__prose {
      grid-column: 1 / -1;
    }
    .case__facts {
      position: static;
      margin-bottom: var(--s-7);
    }
    .case__facts dl {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
