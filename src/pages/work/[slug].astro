---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Edit from "../../components/Edit.astro";
import Todo from "../../components/Todo.astro";

export async function getStaticPaths() {
  const flagships = (await getCollection("work")).filter((w) => w.data.flagship).sort((a, b) => a.data.order - b.data.order);
  return flagships.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: flagships[(i + 1) % flagships.length] } }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.description} image={`/og/${entry.id}.png`}>
  <article class="case">
    <header>
      <p><a href="/#work">Work</a></p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <dl class="facts">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        {d.when && <div><dt>When</dt><dd>{d.when}</dd></div>}
        {d.team && <div><dt>With</dt><dd>{d.team}</dd></div>}
        <div><dt>Built with</dt><dd>{d.stack.join(", ")}</dd></div>
      </dl>
      {d.links.length > 0 && <ul class="links">{d.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>}
    </header>
    {d.cover && (
      <figure class="cover">
        <Image src={d.cover} alt={d.coverAlt ?? ""} widths={[640, 1024, 1600]} sizes="(min-width: 72rem) 72rem, 100vw" loading="eager" />
      </figure>
    )}
    <div class="prose">
      <Content components={{ Edit, Todo }} />
    </div>
    <nav class="next" aria-label="Next case study">
      <a href={`/work/${next.id}/`}>Next: {next.data.title}</a>
    </nav>
  </article>
</Base>
