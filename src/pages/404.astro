---
import Base from "../layouts/Base.astro";
import Painted from "../components/Painted.astro";
---
<Base title="Not found" description="This page doesn’t exist." noindex>
  <article class="lost frame grid">
    <Painted as="h1" top lost class="span-all">Nothing here</Painted>
    <p class="lede lost__text">This page doesn’t exist, so there’s no point you can stand at to read it. <a href="/">Start from the beginning</a> or go straight to <a href="/#work">the work</a>.</p>
  </article>
</Base>

<style>
  .lost {
    padding-top: var(--s-8);
    row-gap: var(--s-7);
  }
  .span-all {
    grid-column: 1 / -1;
  }
  .lost__text {
    grid-column: 1 / span 7;
    max-width: 40ch;
    position: relative;
    z-index: 1;
  }
  @media (max-width: 52rem) {
    .lost__text {
      grid-column: 1 / -1;
    }
  }
</style>
