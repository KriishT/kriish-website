---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Painted from "../components/Painted.astro";
import CopyEmail from "../components/CopyEmail.astro";
import { site, intro, about, lookingFor, education, skills } from "../data/site";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const flagships = work.filter((w) => w.data.flagship);
const archive = work.filter((w) => !w.data.flagship);

// the file loader returns entries by id, so order them explicitly (the résumé's order)
const roles = (await getCollection("roles")).sort((a, b) => a.data.order - b.data.order);
const jobs = roles.filter((r) => !r.data.academic);
const leadership = roles.filter((r) => r.data.academic);
---
<Base person>
  <!-- who Kriish is and what Kriish does -->
  <section class="hero frame" aria-label="Introduction">
    <Painted as="h1" size="xl" top>Kriish <br />Tiwari</Painted>
    <p class="hero__who">{intro.who}</p>
    <ul class="pillars" aria-label="What I do">
      {intro.pillars.map((p) => (
        <li class="pillar">
          <span class="pillar__verb">{p.verb}.</span>
          <span class="pillar__what">{p.what}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- about: in Kriish's own words, then education, then the toolkit -->
  <section id="about" class="section frame" aria-labelledby="about-title">
    <Painted id="about-title">About</Painted>
    <div class="about grid">
      <div class="about__text">
        {about.map((p) => <p>{p}</p>)}
      </div>
      <div class="about__edu">
        <h3 class="label">Education</h3>
        <ol class="edu">
          {education.map((e) => (
            <li>
              <p class="edu__school">{e.school}</p>
              <p class="meta">{e.what}</p>
              <p class="meta">{e.when}</p>
              {e.honours && <p class="edu__honours">{e.honours}</p>}
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="toolkit">
      <h3 class="label">Toolkit</h3>
      <div class="toolkit__groups">
        {skills.map((s) => (
          <div class="toolkit__group">
            <h4>{s.group}</h4>
            <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- experience: roles, then leadership. Text-led, with each organisation's mark -->
  <section id="experience" class="section frame" aria-labelledby="experience-title">
    <Painted id="experience-title">Experience</Painted>
    <ol class="roles">
      {jobs.map((r) => (
        <li class="role grid">
          <div class="role__who">
            {r.data.logo && <Image class="role__logo" src={r.data.logo} alt="" width={56} height={56} />}
            <h3>{r.data.role}</h3>
            <p class="role__org">{r.data.org}</p>
            <p class="meta">{r.data.when}</p>
            <p class="meta">{r.data.where}</p>
          </div>
          <div class="role__what">
            <ul class="role__points">{r.data.points.map((p) => <li>{p}</li>)}</ul>
            <p class="meta role__tools">{r.data.tools.join(", ")}</p>
            {r.data.shot && (
              <figure class="role__shot">
                <Image src={r.data.shot} alt={r.data.shotAlt ?? ""} widths={[420, 840]} sizes="(min-width: 52rem) 26rem, 100vw" loading="lazy" />
                <figcaption>{r.data.links[0]?.label ?? r.data.org}, the company’s site.</figcaption>
              </figure>
            )}
            <p class="role__links">
              {r.data.work && <a href={`/work/${r.data.work}/`}>Read the case study</a>}
              {r.data.links.map((l) => <a href={l.href}>{l.label}</a>)}
            </p>
          </div>
        </li>
      ))}
    </ol>
    <h3 class="sub">Leadership</h3>
    <ol class="roles">
      {leadership.map((r) => (
        <li class="role grid">
          <div class="role__who">
            {r.data.logo && <Image class="role__logo" src={r.data.logo} alt="" width={56} height={56} />}
            <h3>{r.data.role}</h3>
            <p class="role__org">{r.data.org}</p>
            <p class="meta">{r.data.when}</p>
          </div>
          <div class="role__what">
            <ul class="role__points">{r.data.points.map((p) => <li>{p}</li>)}</ul>
            <p class="meta role__tools">{r.data.tools.join(", ")}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- projects: image-led, so they never read as jobs -->
  <section id="projects" class="section frame" aria-labelledby="projects-title">
    <Painted id="projects-title">Projects</Painted>
    <ol class="works">
      {flagships.map((w, i) => (
        <li class="work grid">
          {w.data.cover && (
            <div class="work__shot">
              <Image src={w.data.cover} alt={w.data.coverAlt ?? ""} widths={[480, 800, 1200]} sizes="(min-width: 52rem) 55vw, 100vw" loading={i === 0 ? "eager" : "lazy"} />
            </div>
          )}
          <div class="work__text">
            <p class="meta">{w.data.kind}{w.data.when && `. ${w.data.when}`}</p>
            <h3 class="work__title"><a href={`/work/${w.id}/`} class="work__link">{w.data.title}</a></h3>
            <p class="work__summary">{w.data.summary}</p>
            <p class="work__more" aria-hidden="true">Read the case study</p>
          </div>
        </li>
      ))}
    </ol>

    <h3 class="sub">Also built</h3>
    <ul class="more">
      {archive.map((w) => (
        <li class="more__item">
          {w.data.cover && <Image src={w.data.cover} alt={w.data.coverAlt ?? ""} widths={[400, 640, 900]} sizes="(min-width: 52rem) 45vw, 100vw" loading="lazy" />}
          <p class="meta">{w.data.kind}</p>
          <h4 class="more__title">{w.data.title}</h4>
          <p class="more__summary">{w.data.summary}</p>
          <p class="more__links">{w.data.links.map((l) => <a href={l.href}>{l.label}<span class="visually-hidden"> for {w.data.title}</span></a>)}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="contact" class="section frame" aria-labelledby="contact-title">
    <Painted id="contact-title">Contact</Painted>
    <div class="contact">
      <p class="contact__looking">{lookingFor} Email is the fastest way to reach me.</p>
      <p class="contact__email"><CopyEmail /></p>
      <ul class="contact__links">
        {site.links.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}
        {site.resume && <li><a href={site.resume}>Résumé (PDF)</a></li>}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding-top: var(--s-8);
  }
  .hero__who {
    margin-top: var(--s-6);
    max-width: 28ch;
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: var(--track-heading);
    text-wrap: balance;
  }
  .pillars {
    list-style: none;
    margin: var(--s-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6) var(--gutter);
    position: relative;
    z-index: 1;
  }
  .pillar {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-4);
    border-top: 2px solid var(--ink);
  }
  .pillar__verb {
    font-family: var(--display);
    font-size: var(--step-3);
    font-weight: 800;
    line-height: 1;
    letter-spacing: var(--track-heading);
  }
  .pillar__what {
    max-width: 30ch;
    color: var(--shade);
  }

  /* ---------- shared section parts ---------- */
  .section {
    margin-top: var(--s-11);
  }
  .sub {
    margin-top: var(--s-9);
    font-size: var(--step-2);
    font-weight: 800;
  }
  .label {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--shade);
  }

  /* ---------- about ---------- */
  .about {
    margin-top: var(--s-7);
    row-gap: var(--s-7);
    align-items: start;
  }
  .about__text {
    grid-column: 1 / span 7;
    display: grid;
    gap: var(--s-4);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 44ch;
  }
  .about__edu {
    grid-column: 9 / -1;
  }
  .edu {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
  }
  .edu__school {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 700;
    margin-bottom: var(--s-1);
  }
  .edu__honours {
    margin-top: var(--s-2);
    font-size: var(--step--1);
  }
  /* the toolkit reads like a colophon: five short columns under one rule */
  .toolkit {
    margin-top: var(--s-9);
  }
  .toolkit__groups {
    margin-top: var(--s-4);
    padding-top: var(--s-5);
    border-top: 2px solid var(--ink);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s-6) var(--gutter);
  }
  .toolkit__group h4 {
    font-size: var(--step-0);
    font-weight: 800;
    letter-spacing: 0;
    margin-bottom: var(--s-3);
  }
  .toolkit__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-1);
    color: var(--shade);
  }

  /* ---------- experience ---------- */
  .roles {
    list-style: none;
    margin: var(--s-7) 0 0;
    padding: 0;
    border-top: var(--border);
    position: relative;
    z-index: 1;
    background: var(--wall);
  }
  .role {
    padding-block: var(--s-7);
    border-bottom: var(--border);
    row-gap: var(--s-4);
    align-items: start;
  }
  .role__who {
    grid-column: 1 / span 4;
  }
  .role__logo {
    width: 56px;
    height: 56px;
    object-fit: contain;
    padding: 6px;
    background: #fff;
    outline: 1px solid var(--rule);
    margin-bottom: var(--s-4);
  }
  .role__who h3 {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: 0;
  }
  .role__org {
    margin: var(--s-1) 0 var(--s-2);
    font-family: var(--display);
    font-weight: 600;
  }
  .role__what {
    grid-column: 6 / -1;
    max-width: var(--measure);
  }
  .role__points {
    margin: 0;
    padding-left: 1.1em;
  }
  .role__points li + li {
    margin-top: var(--s-2);
  }
  .role__points li::marker {
    color: var(--paint);
  }
  .role__tools {
    margin-top: var(--s-4);
  }
  .role__shot {
    margin: var(--s-6) 0 0;
    max-width: 26rem;
  }
  .role__shot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    outline: 1px solid var(--rule);
  }
  .role__shot figcaption {
    margin-top: var(--s-2);
    font-family: var(--display);
    font-size: var(--step--1);
    color: var(--shade);
  }
  .role__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-4);
    font-family: var(--display);
    font-weight: 600;
  }
  .role__links:empty {
    display: none;
  }

  /* ---------- projects ---------- */
  .works {
    list-style: none;
    margin: var(--s-7) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-9);
  }
  .work {
    position: relative;
    align-items: start;
  }
  .work__shot {
    grid-column: 1 / span 7;
    background: var(--wall);
  }
  .work__shot img,
  .more__item img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    outline: 1px solid var(--rule);
  }
  .work__text {
    grid-column: 8 / -1;
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .work__title {
    font-size: var(--step-3);
    font-weight: 800;
  }
  .work__link {
    text-decoration: none;
  }
  /* the whole row is one target */
  .work__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .work__summary {
    max-width: 40ch;
  }
  .work__more {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step--1);
    text-decoration: underline;
    text-decoration-color: var(--paint);
    text-underline-offset: 0.25em;
  }
  /* every other row turns round, so the list reads as a sequence, not a stack of cards */
  .work:nth-child(even) .work__shot {
    grid-column: 6 / -1;
    grid-row: 1;
  }
  .work:nth-child(even) .work__text {
    grid-column: 1 / span 4;
    grid-row: 1;
  }
  .work:hover .work__title,
  .work:focus-within .work__title {
    color: var(--paint);
  }
  .work:focus-within {
    outline: 2px solid var(--paint);
    outline-offset: var(--s-3);
  }
  .work__link:focus-visible {
    outline: none;
  }
  .more {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8) var(--gutter);
    position: relative;
    z-index: 1;
  }
  .more__item {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    background: var(--wall);
  }
  .more__item img {
    margin-bottom: var(--s-3);
  }
  .more__title {
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: 0;
  }
  .more__summary {
    color: var(--shade);
    max-width: 46ch;
  }
  .more__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    font-family: var(--display);
    font-size: var(--step--1);
    font-weight: 600;
  }

  /* ---------- contact ---------- */
  .contact {
    margin-top: var(--s-6);
    display: grid;
    gap: var(--s-5);
  }
  .contact__looking {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 46ch;
  }
  .contact__email {
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: var(--track-heading);
  }
  .contact__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 600;
  }

  /* ---------- tablet ---------- */
  @media (max-width: 64rem) {
    .toolkit__groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- phone ---------- */
  @media (max-width: 52rem) {
    .pillars {
      grid-template-columns: 1fr;
      margin-top: var(--s-7);
    }
    .about__text,
    .about__edu,
    .role__who,
    .role__what,
    .work__shot,
    .work__text,
    .work:nth-child(even) .work__shot,
    .work:nth-child(even) .work__text {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .toolkit__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .work {
      row-gap: var(--s-4);
    }
    .more {
      grid-template-columns: 1fr;
    }
  }
</style>
