---
import { Font } from "astro:assets";
import Seo from "../components/Seo.astro";
import CopyEmail from "../components/CopyEmail.astro";
import { site } from "../data/site";
import "../styles/vantage.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  person?: boolean;
}

const nav = [
  { label: "Work", href: "/#work" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f1ec" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-display" preload={[{ weight: 900, style: "normal" }]} />
    <Font cssVariable="--font-text" />
    <Seo {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <div class="site">
      <a class="skip" href="#main">Skip to content</a>
      <header class="site-header frame">
        <a class="wordmark" href="/" aria-current={path === "/" ? "page" : undefined}>{site.name}</a>
        <nav aria-label="Primary">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a></li>
            ))}
            {site.resume && <li><a href={site.resume}>Résumé</a></li>}
          </ul>
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer frame">
        <p>Write to me: <CopyEmail /></p>
        <ul>
          {site.links.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}
          {site.resume && <li><a href={site.resume}>Résumé (PDF)</a></li>}
        </ul>
        <p class="colophon-line">Set in Schibsted Grotesk and Literata. Painted in one colour, ultramarine.</p>
      </footer>
    </div>
    <script>
      import "../scripts/vantage.ts";
    </script>
  </body>
</html>
